# Copy to .env and change the secrets. Docker Compose reads .env automatically.
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_API_KEY=change-me-internal
ADMIN_SIGNUP_KEY=change-me-admin

# bcrypt cost: same value for both backends so login cost is identical
BCRYPT_ROUNDS=10

# Mock payment gateway behaviour (same for both backends)
MOCK_LATENCY_MS=150
MOCK_FAILURE_RATE=0

# Gateway rate limiting: keep false for benchmark runs
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=600
